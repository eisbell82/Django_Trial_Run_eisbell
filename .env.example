# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit the real .env to version control.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com www.yourdomain.com

# SSL (set to True once nginx/certbot is configured)
SECURE_SSL_REDIRECT=False

# Database (leave blank to use SQLite, or set a PostgreSQL URL)
# DATABASE_URL=postgres://user:password@localhost:5432/specimenbase

# Gunicorn
GUNICORN_BIND=unix:/run/gunicorn/specimenbase.sock
GUNICORN_WORKERS=5
GUNICORN_LOG_LEVEL=info
